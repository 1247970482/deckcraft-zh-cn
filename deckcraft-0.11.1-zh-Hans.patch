@@ -0,0 +1,64 @@
+//! Chinese labels must keep the same editing and automation behavior.
+
+use deckcraft_engine::Session;
+use egui_kittest::Harness;
+use egui_kittest::kittest::Queryable;
+use serde_json::json;
+
+use crate::{Services, SlideApp};
+
+fn harness() -> Harness<'static, SlideApp> {
+    let mut h = Harness::builder().with_size(egui::vec2(1600.0, 1000.0)).build_ui_state(
+        |ui, app: &mut SlideApp| {
+            app.logic(ui.ctx());
+            app.ui(ui);
+        },
+        SlideApp::new(Session::with_new(), Services::default()),
+    );
+    h.run_steps(4);
+    h
+}
+
+#[test]
+fn chinese_ribbon_and_menus_preserve_english_tab_ids() {
+    let mut h = harness();
+    assert_eq!(h.state().ui.tab, "Home");
+    h.get_by_label("插入").click();
+    h.run_steps(2);
+    assert_eq!(h.state().ui.tab, "Insert", "translated display does not change the persisted tab ID");
+    h.get_by_label("开始").click();
+    h.run_steps(2);
+    assert_eq!(h.state().ui.tab, "Home");
+
+    let menus = crate::menus::menu_tree();
+    let file = menus.iter().find(|(title, _)| *title == "文件").expect("Chinese File menu");
+    assert!(file.1.iter().any(|(label, id)| *label == "新建演示文稿" && *id == "file.new"));
+    assert!(file.1.iter().any(|(label, id)| *label == "另存为…" && *id == "app.saveAsDialog"));
+}
+
+#[test]
+fn chinese_preferences_cancel_restores_settings() {
+    let mut h = harness();
+    let before = h.state().session.prefs.smart_guides;
+    h.state_mut().run("app.preferences", json!({})).expect("open preferences through the unchanged command ID");
+    h.run_steps(3);
+    h.get_by_label("显示智能参考线").click();
+    h.run_steps(2);
+    assert_eq!(h.state().session.prefs.smart_guides, !before);
+    h.get_by_label("取消").click();
+    h.run_steps(2);
+    assert_eq!(h.state().session.prefs.smart_guides, before);
+    assert!(h.state().dialog.is_none());
+}
+
+#[test]
+fn chinese_command_search_runs_the_original_command() {
+    let mut h = harness();
+    let before = h.state().session.documents().len();
+    h.state_mut().palette = Some(("新建演示文稿".into(), 0));
+    h.run_steps(3);
+    h.get_by_label("新建演示文稿").click();
+    h.run_steps(2);
+    assert_eq!(h.state().session.documents().len(), before + 1);
+    assert!(h.state().palette.is_none());
+}
