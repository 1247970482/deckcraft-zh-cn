@@ -0,0 +1,37 @@
+//! Localize the native app menu after winit creates it. Actions and key equivalents stay intact.
+
+use std::sync::OnceLock;
+
+use objc2_app_kit::NSApplication;
+use objc2_foundation::{MainThreadMarker, NSString};
+
+pub fn apply() {
+    static DONE: OnceLock<()> = OnceLock::new();
+    if DONE.get().is_some() {
+        return;
+    }
+    let Some(main_thread) = MainThreadMarker::new() else { return };
+    let app = NSApplication::sharedApplication(main_thread);
+    let Some(menu) = app.mainMenu() else { return };
+    let mut changed = false;
+    for top in menu.itemArray() {
+        let Some(submenu) = top.submenu() else { continue };
+        for item in submenu.itemArray() {
+            let english = item.title().to_string();
+            let chinese = match english.as_str() {
+                "About DeckCraft" => "关于 DeckCraft",
+                "Services" => "服务",
+                "Hide DeckCraft" => "隐藏 DeckCraft",
+                "Hide Others" => "隐藏其他应用",
+                "Show All" => "全部显示",
+                "Quit DeckCraft" => "退出 DeckCraft",
+                _ => continue,
+            };
+            item.setTitle(&NSString::from_str(chinese));
+            changed = true;
+        }
+    }
+    if changed {
+        let _ = DONE.set(());
+    }
+}
