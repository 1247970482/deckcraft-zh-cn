+#[cfg(test)]
+mod regroup_tests {
+    #![allow(clippy::unwrap_used, clippy::expect_used)]
+
+    use super::*;
+
+    fn group_ungroup_regroup(legacy_history_label: bool) {
+        let mut s = Session::with_new();
+        let a = s.execute("shape.insert", &json!({"preset": "rect", "rect": [100, 100, 50, 50]})).unwrap()["id"].as_u64().unwrap();
+        let b = s.execute("shape.insert", &json!({"preset": "rect", "rect": [300, 200, 50, 50]})).unwrap()["id"].as_u64().unwrap();
+        let members = vec![ShapeId(a as u32), ShapeId(b as u32)];
+        let group = s.execute("arrange.group", &json!({"ids": [a, b]})).unwrap()["id"].as_u64().unwrap();
+        s.execute("shape.move", &json!({"id": group, "dx": 10})).unwrap();
+        s.execute("arrange.ungroup", &json!({"ids": [group]})).unwrap();
+        assert_eq!(s.doc().unwrap().selection.shapes, members);
+        assert_eq!(s.doc().unwrap().history.undo.last().unwrap().label, "取消组合");
+        if legacy_history_label {
+            s.doc_mut().unwrap().history.undo.last_mut().unwrap().label = "Ungroup".into();
+        }
+
+        let regrouped = s.execute("arrange.regroup", &json!({})).unwrap()["id"].as_u64().unwrap();
+        let shape = s.doc().unwrap().shape(ShapeId(regrouped as u32)).unwrap();
+        assert!(shape.is_group());
+        assert_eq!(shape.children().iter().map(|c| c.id).collect::<Vec<_>>(), members);
+        s.execute("arrange.ungroup", &json!({"ids": [regrouped]})).unwrap();
+        let inspected = s.execute("shape.inspect", &json!({"id": b})).unwrap();
+        assert!((inspected["box"]["x"].as_f64().unwrap() - 310.0).abs() < 1e-6, "{inspected}");
+    }
+
+    #[test]
+    fn regroup_uses_the_current_localized_ungroup_label() {
+        group_ungroup_regroup(false);
+    }
+
+    #[test]
+    fn regroup_accepts_legacy_english_ungroup_history() {
+        group_ungroup_regroup(true);
+    }
+}
